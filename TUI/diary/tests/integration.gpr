project Integration is
   for Source_Dirs use (".", "support");
   for Source_Files use
     ("run_storage_tests.adb", "tui_smoke.adb",
      "test_fixtures.ads", "test_fixtures.adb",
      "test_posix.ads", "test_posix.adb",
      "test_processes.ads", "test_processes.adb",
      "test_terminals.ads", "test_terminals.adb");
   for Object_Dir use "../obj/integration";
   for Exec_Dir use "../bin";
   for Main use ("run_storage_tests.adb", "tui_smoke.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatW8", "-gnata", "-g", "-gnatwa");
   end Compiler;
end Integration;
