with "diary_domain";
with "diary_application";
with "diary_storage";
project Tests is
   for Source_Dirs use (".");
   for Source_Files use ("domain_tests.adb", "storage_tests.adb", "editor_tests.adb", "codec_tests.adb");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use "../bin";
   for Main use ("domain_tests.adb", "storage_tests.adb", "editor_tests.adb", "codec_tests.adb");
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatW8", "-gnata", "-g", "-gnatwa");
   end Compiler;
end Tests;
