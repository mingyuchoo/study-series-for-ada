with "diary_domain";
with "diary_application";
with "diary_storage";
with "malef";
project Diary is
   for Source_Dirs use ("apps/diary/src");
   for Object_Dir use "obj/diary";
   for Exec_Dir use "bin";
   for Main use ("diary.adb");
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatW8", "-gnata", "-g", "-O0", "-gnatwa");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-Es", "-W8");
   end Binder;
end Diary;
