with "tui_presentation";
with "malef";
project Tui_Template is
   for Source_Dirs use ("apps/tui_template/src");
   for Object_Dir use "obj/tui_template";
   for Exec_Dir use "bin";
   for Main use ("tui_template.adb");
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatW8", "-gnata", "-g", "-O0", "-gnatwa");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-Es", "-W8");
   end Binder;
end Tui_Template;
