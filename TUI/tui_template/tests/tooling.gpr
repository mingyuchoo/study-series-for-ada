with "tui_tooling";
with "tui_tooling_policy";
project Tooling is
   for Source_Dirs use ("tooling");
   for Object_Dir use "../obj/tooling-tests";
   for Exec_Dir use "../bin";
   for Main use ("tooling_tests.adb", "tooling_file_tests.adb");
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatW8", "-gnata", "-g", "-gnatwa");
   end Compiler;
end Tooling;
