with "counter_application.gpr";

project Counter_Tk is
   for Source_Dirs use ("src", "src/adapters");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("counter_tk.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Counter_Tk;
